{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentalbridge.local/contracts/events/identity/user-notification-fact-v1.schema.json",
  "title": "Identity user notification fact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "messageType", "occurredAt", "producer", "schemaVersion", "correlationId", "aggregateId", "aggregateVersion", "payload"],
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "identity.user-notification.fact" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "identity-service" },
    "schemaVersion": { "const": "1.0" },
    "correlationId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "aggregateVersion": { "type": "integer", "minimum": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipientId", "actorType", "factType", "availableAt"],
      "properties": {
        "recipientId": { "type": "string", "format": "uuid" },
        "actorType": { "enum": ["USER", "SPECIALIST"] },
        "factType": { "enum": ["ACCOUNT_ACTIVATED", "ACCOUNT_RESTORED"] },
        "availableAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
