{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentalbridge.local/contracts/events/identity/account-state-changed-v1.schema.json",
  "title": "Identity account state changed",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "messageType", "occurredAt", "producer", "schemaVersion", "correlationId", "aggregateId", "aggregateVersion", "payload"],
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "identity.account.state-changed" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "identity-service" },
    "schemaVersion": { "const": "1.0" },
    "correlationId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "aggregateVersion": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "status", "role", "reasonCode"],
      "properties": {
        "accountId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["PENDING_EMAIL_VERIFICATION", "ACTIVE", "DISABLED"] },
        "role": { "enum": ["USER", "SPECIALIST"] },
        "reasonCode": { "enum": ["SAFETY_CONCERN", "POLICY_VIOLATION", "ACCOUNT_REVIEW_REQUIRED", "REVIEW_COMPLETED"] }
      }
    }
  }
}
