{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentalbridge.local/contracts/events/care/assessment-submitted-v1.schema.json",
  "title": "Care assessment submitted",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "messageType", "occurredAt", "producer", "schemaVersion", "correlationId", "aggregateId", "aggregateVersion", "payload"],
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "care.assessment.submitted" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "care-service" },
    "schemaVersion": { "const": "1.0" },
    "correlationId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "aggregateVersion": { "const": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentId", "ownerType", "questionnaireDefinitionId", "instrument", "questionnaireVersion", "scoringVersion", "screeningLevel", "safetyStatus", "safetyPolicyVersion"],
      "properties": {
        "assessmentId": { "type": "string", "format": "uuid" },
        "ownerType": { "enum": ["AUTHENTICATED_USER", "ANONYMOUS"] },
        "userId": { "type": "string", "format": "uuid" },
        "questionnaireDefinitionId": { "type": "string", "format": "uuid" },
        "instrument": { "const": "PHQ9" },
        "questionnaireVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "scoringVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "screeningLevel": { "enum": ["MINIMAL", "MILD", "MODERATE", "MODERATELY_SEVERE", "SEVERE"] },
        "safetyStatus": { "enum": ["NEGATIVE_SAFETY_SCREEN", "POSITIVE_SAFETY_SCREEN"] },
        "safetyPolicyVersion": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "allOf": [
        {
          "if": { "properties": { "ownerType": { "const": "AUTHENTICATED_USER" } } },
          "then": { "required": ["userId"] }
        },
        {
          "if": { "properties": { "ownerType": { "const": "ANONYMOUS" } } },
          "then": { "not": { "required": ["userId"] } }
        }
      ]
    }
  }
}
