{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentalbridge.local/contracts/events/care/user-notification-fact-v1.schema.json",
  "title": "Care user notification fact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "messageType", "occurredAt", "producer", "schemaVersion", "correlationId", "aggregateId", "aggregateVersion", "payload"],
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "const": "care.user-notification.fact" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "care-service" },
    "schemaVersion": { "const": "1.0" },
    "correlationId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "aggregateVersion": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipientId", "factType", "targetId", "targetVersion", "availableAt"],
      "properties": {
        "recipientId": { "type": "string", "format": "uuid" },
        "factType": {
          "enum": [
            "ASSESSMENT_RESULT_AVAILABLE",
            "SUPPORT_GUIDE_AVAILABLE"
          ]
        },
        "targetId": { "type": "string", "format": "uuid" },
        "targetVersion": { "type": "integer", "minimum": 0 },
        "availableAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
