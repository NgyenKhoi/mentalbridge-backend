{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentalbridge.local/contracts/events/community/community-interaction-v1.schema.json",
  "title": "Community interaction notification fact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "schemaVersion",
    "actorCommunityProfileId",
    "targetOwnerRoutingReference",
    "targetType",
    "targetId",
    "interactionKind",
    "occurredAt",
    "deepLink"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "schemaVersion": { "const": "1.0" },
    "actorCommunityProfileId": { "type": "string", "format": "uuid" },
    "targetOwnerRoutingReference": { "type": "string", "format": "uuid" },
    "targetType": { "enum": ["POST", "COMMENT"] },
    "targetId": { "type": "string", "format": "uuid" },
    "interactionKind": {
      "enum": ["COMMENT", "REPLY", "SUPPORT", "RELATE", "THANK_YOU"]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "deepLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "postId"],
      "properties": {
        "kind": { "const": "COMMUNITY_POST" },
        "postId": { "type": "string", "format": "uuid" }
      }
    }
  }
}
