{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentalbridge.dev/contracts/proposals/companion-voice-policy-v1.schema.json",
  "title": "companion-voice-policy-v1",
  "description": "Frozen MB-755 approved target. A changed product value requires a new policy version and explicit approval; this file does not activate voice runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "decisionId",
    "approvalDate",
    "status",
    "timeZone",
    "packages",
    "limits",
    "usage",
    "privacy",
    "providers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyVersion": {
      "const": "companion-voice-policy-v1"
    },
    "decisionId": {
      "const": "MB-AI-VOICE-COMPANION-001"
    },
    "approvalDate": {
      "const": "2026-10-23"
    },
    "status": {
      "const": "APPROVED_TARGET_NOT_IMPLEMENTED"
    },
    "timeZone": {
      "const": "Asia/Ho_Chi_Minh"
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FREE", "PLUS", "PREMIUM"],
      "properties": {
        "FREE": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voiceEligible",
            "sessionsPerDay",
            "dailySeconds",
            "perSessionSeconds"
          ],
          "properties": {
            "voiceEligible": {
              "const": false
            },
            "sessionsPerDay": {
              "const": 0
            },
            "dailySeconds": {
              "const": 0
            },
            "perSessionSeconds": {
              "const": 0
            }
          }
        },
        "PLUS": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voiceEligible",
            "sessionsPerDay",
            "dailySeconds",
            "perSessionSeconds"
          ],
          "properties": {
            "voiceEligible": {
              "const": true
            },
            "sessionsPerDay": {
              "const": 2
            },
            "dailySeconds": {
              "const": 600
            },
            "perSessionSeconds": {
              "const": 300
            }
          }
        },
        "PREMIUM": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voiceEligible",
            "sessionsPerDay",
            "dailySeconds",
            "perSessionSeconds"
          ],
          "properties": {
            "voiceEligible": {
              "const": true
            },
            "sessionsPerDay": {
              "const": 3
            },
            "dailySeconds": {
              "const": 1800
            },
            "perSessionSeconds": {
              "const": 600
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalSessions",
        "userSessions",
        "idleTimeoutSeconds",
        "reconnectGraceSeconds",
        "authorizationLeaseSeconds",
        "leaseRenewalSeconds",
        "ownerReadTimeoutMilliseconds",
        "connectTimeoutSeconds",
        "requestTimeoutSeconds",
        "startAttemptsPerMinute",
        "startAttemptsPerDay",
        "maxContextTurnPairs",
        "maxContextTokens",
        "maxFinalTranscriptCharacters",
        "maxSpokenReplyCharacters"
