  "components": {
    "schemas": {
      "CommunityFriendshipState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "friendshipId"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "SELF",
              "NONE",
              "OUTGOING",
              "INCOMING",
              "FRIENDS"
            ]
          },
          "friendshipId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "CommunityFriendship": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "friendshipId",
          "peer",
          "state",
          "createdAt"
        ],
        "properties": {
          "friendshipId": {
            "type": "string",
            "format": "uuid"
          },
          "peer": {
            "$ref": "#/components/schemas/CommunityMemberIdentity"
          },
          "state": {
            "type": "string",
            "enum": [
              "OUTGOING",
              "INCOMING",
              "FRIENDS"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CommunityFriendshipPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunityFriendship"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "CommunityMemberProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member",
          "friendship",
          "posts"
        ],
        "properties": {
          "member": {
            "$ref": "#/components/schemas/CommunityMemberIdentity"
          },
          "friendship": {
            "$ref": "#/components/schemas/CommunityFriendshipState"
          },
          "posts": {
            "$ref": "./community-service-v1.yaml#/components/schemas/CommunityFeedPage"
          }
        }
      },
      "CommunityMemberPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunityMemberIdentity"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "CommunityMemberIdentity": {
        "allOf": [
          {
            "$ref": "./community-service-v1.yaml#/components/schemas/CommunityAuthor"
          },
          {
            "type": "object",
            "required": [
              "communityProfileId",
              "state"
            ],
            "properties": {
              "communityProfileId": {
                "type": "string",
                "format": "uuid"
              },
              "state": {
                "type": "string",
                "enum": [
                  "ACTIVE"
                ]
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
