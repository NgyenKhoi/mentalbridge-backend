{
  "openapi": "3.1.0",
  "info": {
    "title": "Community friendships and member profiles",
    "version": "1.0.0",
    "description": "Opt-in reciprocal friendships. COMMUNITY_FRIENDS_ENABLED requires friendship for new direct conversations and group invitations. Existing active conversations remain usable. Public member pages contain named Community posts only."
  },
  "paths": {
    "/api/v1/community/chat/friends": {
      "get": {
        "operationId": "listCommunityFriends",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "accepted",
                "incoming",
                "outgoing"
              ],
              "default": "accepted"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful owner-authorized response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityFriendshipPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, unauthorized, inaccessible, conflicting or unavailable request",
