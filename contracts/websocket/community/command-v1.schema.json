{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentalbridge.dev/contracts/websocket/community/command-v1.schema.json",
  "title": "community-chat-command-v1.schema.json",
  "description": "MB-689 runtime subset. Presence/typing/receipt variants remain planned for MB-690. community.command uses command envelopes; community.event emits these private event envelopes.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandId",
        "correlationId",
        "commandType",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "commandType": {
          "const": "community.conversation.subscribe"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversationId"
          ],
          "properties": {
            "conversationId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  ],
  "$defs": {}
}
