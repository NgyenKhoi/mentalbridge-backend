{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentalbridge.dev/contracts/websocket/community/event-v1.schema.json",
  "title": "community-chat-realtime-v1.schema.json",
  "description": "MB-689 message/private-read transport, MB-690 opt-in privacy-aware presence and MB-745 authorized message replacement. Typing and shared receipt variants remain deferred.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "correlationId",
        "occurredAt",
        "eventType",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "eventType": {
          "const": "community.message.created"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "$ref": "#/$defs/message"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "eventId", "correlationId", "occurredAt", "eventType", "payload"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "eventId": { "type": "string", "format": "uuid" },
        "correlationId": { "type": "string", "format": "uuid" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "eventType": { "const": "community.message.updated" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "properties": { "message": { "$ref": "#/$defs/message" } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "correlationId",
        "occurredAt",
        "eventType",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "eventType": {
          "const": "community.conversation.invalidated"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversationId"
          ],
          "properties": {
            "conversationId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "correlationId",
        "occurredAt",
        "eventType",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "eventType": {
          "const": "community.resync.required"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversationId"
          ],
          "properties": {
            "conversationId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "correlationId",
        "occurredAt",
        "eventType",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "eventType": {
          "const": "community.command.ack"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "status"
          ],
          "properties": {
            "commandId": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "const": "ACCEPTED"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "correlationId",
        "occurredAt",
        "eventType",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "eventType": {
          "const": "community.command.error"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "code",
            "retryable"
          ],
          "properties": {
            "commandId": {
              "type": "string",
              "format": "uuid"
            },
            "code": {
              "type": "string",
              "enum": [
                "INVALID_COMMAND",
                "UNAUTHENTICATED",
                "TARGET_UNAVAILABLE",
                "RATE_LIMITED",
                "DEPENDENCY_UNAVAILABLE"
              ]
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "correlationId",
        "occurredAt",
        "eventType",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "eventType": {
          "const": "community.read-state.changed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversationId",
            "lastReadMessageId",
            "unreadCount"
          ],
          "properties": {
            "conversationId": {
              "type": "string",
              "format": "uuid"
            },
            "lastReadMessageId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "unreadCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "correlationId",
        "occurredAt",
        "eventType",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "eventType": {
          "const": "community.presence.changed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "communityProfileId",
            "state"
          ],
          "properties": {
            "communityProfileId": {
              "type": "string",
              "format": "uuid"
            },
            "state": {
              "type": "string",
              "enum": [
                "ONLINE",
                "OFFLINE",
                "UNKNOWN"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "conversationId",
        "clientMessageId",
        "sender",
        "state",
        "createdAt"
      ],
      "properties": {
        "messageId": {
          "type": "string",
          "format": "uuid"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "clientMessageId": {
          "type": "string",
          "format": "uuid"
        },
        "sender": {
          "$ref": "#/$defs/peer"
        },
        "state": {
          "type": "string",
          "enum": ["ACTIVE", "RETRACTED"]
        },
        "content": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "retractedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "oneOf": [
        {
          "required": ["content"],
          "properties": {
            "state": { "const": "ACTIVE" },
            "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "retractedAt": false
          }
        },
        {
          "required": ["retractedAt"],
          "properties": {
            "state": { "const": "RETRACTED" },
            "content": false,
            "retractedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "peer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "communityProfileId",
            "displayName"
          ],
          "properties": {
            "state": {
              "const": "AVAILABLE"
            },
            "communityProfileId": {
              "type": "string",
              "format": "uuid"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "UNAVAILABLE"
            }
          }
        }
      ]
    }
  }
}
