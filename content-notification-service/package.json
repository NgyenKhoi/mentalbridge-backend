{
  "name": "content-notification-service",
  "version": "1.0.0",
  "description": "MentalBridge Content and Notification Service",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:review1:up": "node-pg-migrate up --migrations-dir migrations/review1 --migrations-table pgmigrations_review1",
    "migrate:review1:down": "node-pg-migrate down --migrations-dir migrations/review1 --migrations-table pgmigrations_review1",
    "migrate:review1-demo": "npm run migrate:up && npm run migrate:review1:up",
    "migrate:create": "node-pg-migrate create",
    "migration:check": "node scripts/validate-migrations.mjs",
    "contract:check": "node scripts/validate-contracts.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.2.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.10",
    "node-pg-migrate": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@eslint/js": "^9.9.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "testcontainers": "^10.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.1.8"
  }
}
