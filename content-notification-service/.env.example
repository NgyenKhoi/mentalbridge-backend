# PostgreSQL
DATABASE_URL=postgres://postgres:change_me@localhost:5432/mentalbridge_content_notification?sslmode=disable
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=2000

# App
PORT=3003
NODE_ENV=development
LOG_LEVEL=info

# CORS — comma-separated allowed origins (leave empty to deny all)
CORS_ORIGINS=http://localhost:3000

# JWT Authentication (Identity Service Integration)
IDENTITY_JWT_ISSUER=https://identity.local.mentalbridge
IDENTITY_JWT_AUDIENCE=mentalbridge-api
IDENTITY_JWT_KEY_ID=local-development-key
IDENTITY_JWT_PUBLIC_KEY=replace-with-x509-pem-public-key
IDENTITY_JWT_CLOCK_TOLERANCE_SECONDS=60

# Service-authorized Journal/AI activity projection and bounded reminder scheduler
JOURNAL_AI_SERVICE_URL=http://localhost:3005
JOURNAL_AI_SERVICE_TIMEOUT_MS=2000
JOURNAL_AI_REMINDER_SERVICE_TOKEN=replace-with-shared-32-character-secret
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_INTERVAL_MS=60000
REMINDER_SCHEDULER_BATCH_SIZE=100

# MB-514 daily wellbeing email delivery. Reuse the verified development Brevo sender.
WELLBEING_DIGEST_SCHEDULER_ENABLED=false
WELLBEING_DIGEST_SCHEDULER_INTERVAL_MS=60000
WELLBEING_DIGEST_BATCH_SIZE=100
IDENTITY_SERVICE_URL=http://localhost:8080
IDENTITY_NOTIFICATION_SERVICE_TOKEN=replace-with-shared-32-character-secret
BREVO_BASE_URL=https://api.brevo.com
BREVO_API_KEY=replace-with-development-brevo-key
BREVO_SENDER_EMAIL=replace-with-verified-development-sender
BREVO_SENDER_NAME=MentalBridge

# Identity account lifecycle projection. Compose provisions the versioned topics.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CONTENT_ACCOUNT_LIFECYCLE_CONSUMER_ENABLED=false

# One appointment email reminder. Disabled until the versioned Kafka topic,
# service endpoints, verified Brevo sender, and shared service token exist.
APPOINTMENT_REMINDER_ENABLED=false
CONTENT_APPOINTMENT_CONSUMER_ENABLED=false
APPOINTMENT_REMINDER_SERVICE_TOKEN=replace-with-shared-32-character-secret
CONSULTATION_SERVICE_URL=http://localhost:8082
APPOINTMENT_REMINDER_HTTP_TIMEOUT_MS=2000
APPOINTMENT_REMINDER_APP_URL=http://localhost:3000/appointments/

# Disabled by default. Set only for a local controlled E2E run.
E2E_TEST_MODE=false
E2E_TEST_SECRET=replace-with-a-local-random-secret
