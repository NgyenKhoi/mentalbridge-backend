# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mentalbridge_content_notification
DB_USER=postgres
DB_PASSWORD=change_me
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=2000

# App
PORT=3003
NODE_ENV=development
LOG_LEVEL=info

# CORS — comma-separated allowed origins (leave empty to deny all)
CORS_ORIGINS=http://localhost:3000

# node-pg-migrate reads this real process variable; the application does not load it.
DATABASE_URL=postgres://postgres:change_me@localhost:5432/mentalbridge_content_notification

# JWT Authentication (Identity Service Integration)
IDENTITY_JWT_ISSUER=https://identity.local.mentalbridge
IDENTITY_JWT_AUDIENCE=mentalbridge-api
IDENTITY_JWT_KEY_ID=local-development-key
IDENTITY_JWT_PUBLIC_KEY=replace-with-x509-pem-public-key
IDENTITY_JWT_CLOCK_TOLERANCE_SECONDS=60
