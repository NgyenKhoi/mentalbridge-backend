{
  "name": "mentalbridge-ai-voice-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format:check": "prettier --check \"*.{json,js,md}\" \"src/**/*.ts\"",
    "test": "npm run build && node --test dist/*.test.js",
    "contract:check": "node scripts/check-contract.mjs",
    "migration:check": "node scripts/check-boundaries.mjs",
    "start": "node dist/main.js start",
    "dev": "node dist/main.js dev"
  },
  "dependencies": {
    "@livekit/agents": "1.9.4",
    "@livekit/agents-plugin-silero": "1.9.4",
    "@livekit/protocol": "1.53.1",
    "@livekit/rtc-node": "1.2.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "0.6.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
