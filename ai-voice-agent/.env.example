# Inject through managed secrets or an explicit local --env-file outside the repo.
# No provider connection occurs while disabled. CI never enables this.
AI_VOICE_AGENT_ENABLED=false
# MB-762 only: reserve TTS characters per worker attempt; pin Nova-3/approved voice.
AI_VOICE_PILOT=false
# Integer 1..8000; default 1200. Change only for an approved pilot budget.
AI_VOICE_PILOT_TTS_MAX_CHARACTERS=1200
# Adjacent-final aggregation pause, integer 500..1500 milliseconds.
AI_VOICE_FINAL_AGGREGATION_MS=1500
AI_VOICE_AGENT_APPROVAL_VERSION=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AI_VOICE_JOURNAL_BASE_URL=http://127.0.0.1:3002
# Match JOURNAL_AI_VOICE_WORKER_SERVICE_TOKEN in Journal; do not reuse LiveKit secret.
AI_VOICE_JOURNAL_SERVICE_TOKEN=
AI_VOICE_STT_MODEL=deepgram/nova-3
AI_VOICE_TTS_MODEL=cartesia/sonic-3-2026-01-12
# Explicit reviewed Cartesia voice; blank prevents enablement, no silent default.
# Current pilot: Lien 8e8f222d-c817-4cc5-822b-8bf76ca7e98d.
# Historical approved Xia: b8cd71e3-bc14-4538-a530-d6314731c036.
AI_VOICE_TTS_VOICE_ID=
