# Inject through managed secrets or an explicit local --env-file outside the repo.
# No provider connection occurs while disabled. CI never enables this.
AI_VOICE_AGENT_ENABLED=false
AI_VOICE_AGENT_APPROVAL_VERSION=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AI_VOICE_JOURNAL_BASE_URL=http://127.0.0.1:3002
# Match JOURNAL_AI_VOICE_WORKER_SERVICE_TOKEN in Journal; do not reuse LiveKit secret.
AI_VOICE_JOURNAL_SERVICE_TOKEN=
AI_VOICE_STT_MODEL=deepgram/nova-3
AI_VOICE_TTS_MODEL=cartesia/sonic-3-2026-01-12
# Reviewed default Cartesia voice UUID selected in MB-760; no cloned/custom voice.
AI_VOICE_TTS_VOICE_ID=
