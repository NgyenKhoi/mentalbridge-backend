# HTTP port used by the Journal and AI Service.
JOURNAL_AI_PORT=3000

# development, test, or production.
NODE_ENV=development

# Pino log level.
JOURNAL_AI_LOG_LEVEL=info

# MongoDB database owned by the Journal and AI Service.
JOURNAL_AI_MONGODB_URI=mongodb://localhost:27017
JOURNAL_AI_MONGODB_DATABASE=mentalbridge_journal_ai
JOURNAL_AI_MONGODB_CONNECTION_TIMEOUT_MS=2000

# Generate separate values with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
JOURNAL_AI_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
JOURNAL_AI_ENCRYPTION_KEY_ID=local-v1
JOURNAL_AI_IDEMPOTENCY_HMAC_KEY=replace-with-a-different-base64-encoded-32-byte-key

# Identity-issued access-token verification. The private key remains in Identity Service only.
IDENTITY_JWT_ISSUER=https://identity.local.mentalbridge
IDENTITY_JWT_AUDIENCE=mentalbridge-api
IDENTITY_JWT_KEY_ID=local-development-key
IDENTITY_JWT_PUBLIC_KEY=replace-with-x509-pem-public-key

# Care consent authorization. The verified end-user bearer is forwarded and never persisted.
JOURNAL_AI_CARE_BASE_URL=http://localhost:8081
JOURNAL_AI_CARE_TIMEOUT_MS=2000

# Consultation is the authoritative source for FREE/PLUS/PREMIUM. The verified end-user bearer is forwarded.
JOURNAL_AI_CONSULTATION_BASE_URL=http://localhost:8082
JOURNAL_AI_CONSULTATION_TIMEOUT_MS=2000

# Real routes stay disabled until an exact benchmark approval version and credentials are configured.
JOURNAL_AI_PROVIDER_MODE=DETERMINISTIC_FAKE
JOURNAL_AI_ROUTING_POLICY_VERSION=exact-revision-routing-v1
# JOURNAL_AI_PROVIDER_APPROVAL_VERSION=replace-with-accepted-benchmark-approval
# JOURNAL_AI_FREE_PLUS_PROVIDER=GEMINI
# JOURNAL_AI_FREE_PLUS_MODEL=replace-with-pinned-model-id
# JOURNAL_AI_FREE_PLUS_INPUT_COST_MICRO_USD_PER_MILLION_TOKENS=0
# JOURNAL_AI_FREE_PLUS_OUTPUT_COST_MICRO_USD_PER_MILLION_TOKENS=0
# JOURNAL_AI_PREMIUM_PROVIDER=GEMINI
# JOURNAL_AI_PREMIUM_MODEL=replace-with-pinned-stronger-model-id
# JOURNAL_AI_PREMIUM_INPUT_COST_MICRO_USD_PER_MILLION_TOKENS=0
# JOURNAL_AI_PREMIUM_OUTPUT_COST_MICRO_USD_PER_MILLION_TOKENS=0
JOURNAL_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# JOURNAL_AI_GEMINI_API_KEY=replace-with-secret
JOURNAL_AI_OPENAI_BASE_URL=https://api.openai.com
# JOURNAL_AI_OPENAI_API_KEY=replace-with-secret
JOURNAL_AI_PROVIDER_TIMEOUT_MS=30000

# Explicit paid benchmark command only. CI and ordinary runtime keep this false.
JOURNAL_AI_BENCHMARK_ENABLED=false
JOURNAL_AI_BENCHMARK_DATASET_PATH=benchmarks/datasets/exact-revision-synthetic-v1.json
# JOURNAL_AI_BENCHMARK_GEMINI_MODEL=replace-with-pinned-candidate-model
# JOURNAL_AI_BENCHMARK_GEMINI_INPUT_COST_MICRO_USD_PER_MILLION_TOKENS=0
# JOURNAL_AI_BENCHMARK_GEMINI_OUTPUT_COST_MICRO_USD_PER_MILLION_TOKENS=0
# JOURNAL_AI_BENCHMARK_OPENAI_MODEL=replace-with-pinned-candidate-model
# JOURNAL_AI_BENCHMARK_OPENAI_INPUT_COST_MICRO_USD_PER_MILLION_TOKENS=0
# JOURNAL_AI_BENCHMARK_OPENAI_OUTPUT_COST_MICRO_USD_PER_MILLION_TOKENS=0

# Exact-revision analysis worker. Keep disabled in production until the controlled enablement gate passes.
JOURNAL_AI_ANALYSIS_ENABLED=true
JOURNAL_AI_ANALYSIS_POLL_INTERVAL_MS=250
JOURNAL_AI_ANALYSIS_LEASE_MS=35000
