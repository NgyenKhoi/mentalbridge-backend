# HTTP port used by the Journal and AI Service.
JOURNAL_AI_PORT=3000

# development, test, or production.
NODE_ENV=development

# Pino log level.
JOURNAL_AI_LOG_LEVEL=info

# MongoDB database owned by the Journal and AI Service.
JOURNAL_AI_MONGODB_URI=mongodb://localhost:27017
JOURNAL_AI_MONGODB_DATABASE=mentalbridge_journal_ai
JOURNAL_AI_MONGODB_CONNECTION_TIMEOUT_MS=2000

# Generate separate values with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
JOURNAL_AI_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
JOURNAL_AI_ENCRYPTION_KEY_ID=local-v1
JOURNAL_AI_IDEMPOTENCY_HMAC_KEY=replace-with-a-different-base64-encoded-32-byte-key

# Identity-issued access-token verification. The private key remains in Identity Service only.
IDENTITY_JWT_ISSUER=https://identity.local.mentalbridge
IDENTITY_JWT_AUDIENCE=mentalbridge-api
IDENTITY_JWT_KEY_ID=local-development-key
IDENTITY_JWT_PUBLIC_KEY=replace-with-x509-pem-public-key
