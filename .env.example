# Community service-owned PostgreSQL database, JWT verification and Cloudinary configuration.
COMMUNITY_DB_URL=jdbc:postgresql://localhost:5436/mentalbridge_community
COMMUNITY_DB_USERNAME=mentalbridge_community
COMMUNITY_DB_PASSWORD=replace-with-a-local-secret
COMMUNITY_LIQUIBASE_ENABLED=false
CLOUDINARY_CLOUD_NAME=replace-with-development-cloud-name
CLOUDINARY_API_KEY=replace-with-development-api-key
CLOUDINARY_API_SECRET=replace-with-development-api-secret
CLOUDINARY_TIMEOUT_SECONDS=5
COMMUNITY_MEDIA_MAX_IMAGE_BYTES=10485760
COMMUNITY_MEDIA_MAX_VIDEO_BYTES=52428800
COMMUNITY_MEDIA_MAX_VIDEO_DURATION_SECONDS=60
COMMUNITY_MEDIA_UPLOAD_INTENT_TTL=10m
COMMUNITY_MEDIA_ORPHAN_RETENTION=24h
COMMUNITY_MEDIA_CLEANUP_INTERVAL=1h
COMMUNITY_INTERACTION_RELAY_ENABLED=false
COMMUNITY_INTERACTION_RELAY_BATCH_SIZE=100
COMMUNITY_INTERACTION_RELAY_INTERVAL=PT5S
COMMUNITY_INTERACTION_RELAY_SEND_TIMEOUT=PT5S
COMMUNITY_INTERACTION_RELAY_RETRY_BASE=PT5S
COMMUNITY_INTERACTION_RELAY_RETRY_MAXIMUM=PT5M

# Journal and AI service-owned MongoDB database and Identity JWT verification.
JOURNAL_AI_PORT=3000
JOURNAL_AI_LOG_LEVEL=info
JOURNAL_AI_MONGODB_URI=mongodb://localhost:27017
JOURNAL_AI_MONGODB_DATABASE=mentalbridge_journal_ai
JOURNAL_AI_MONGODB_CONNECTION_TIMEOUT_MS=2000
CONTENT_JOURNAL_AI_SERVICE_TIMEOUT_MS=2000
JOURNAL_AI_REMINDER_SERVICE_TOKEN=replace-with-shared-32-character-secret
JOURNAL_AI_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
JOURNAL_AI_IDEMPOTENCY_HMAC_KEY=replace-with-a-different-base64-encoded-32-byte-key
CONTENT_REMINDER_SCHEDULER_ENABLED=true
CONTENT_REMINDER_SCHEDULER_INTERVAL_MS=60000
CONTENT_REMINDER_SCHEDULER_BATCH_SIZE=100
CONTENT_WELLBEING_DIGEST_SCHEDULER_ENABLED=true
CONTENT_WELLBEING_DIGEST_SCHEDULER_INTERVAL_MS=60000
CONTENT_WELLBEING_DIGEST_BATCH_SIZE=100
CONTENT_ACCOUNT_LIFECYCLE_CONSUMER_ENABLED=false
CONTENT_COMMUNITY_INTERACTION_CONSUMER_ENABLED=false
CONTENT_CARE_USER_NOTIFICATION_CONSUMER_ENABLED=false

# Realtime service-owned MongoDB, ephemeral Redis, socket limits and message encryption.
REALTIME_PORT=3004
PUBLIC_REALTIME_ORIGIN=http://localhost:3004
REALTIME_LOG_LEVEL=info
REALTIME_CORS_ORIGINS=http://localhost:3000
REALTIME_MONGODB_URI=mongodb://localhost:27017
REALTIME_MONGODB_DATABASE=mentalbridge_realtime
REALTIME_MONGODB_CONNECTION_TIMEOUT_MS=2000
REALTIME_REDIS_URL=redis://localhost:6379
CONSULTATION_BASE_URL=http://localhost:8082
CONSULTATION_TIMEOUT_MS=2000
CONSULTATION_EVIDENCE_SERVICE_TOKEN=replace-with-shared-at-least-32-character-token
REALTIME_REDIS_CONNECTION_TIMEOUT_MS=1000
REALTIME_PRESENCE_TTL_SECONDS=45
REALTIME_PRESENCE_HEARTBEAT_SECONDS=15
REALTIME_MAX_CONNECTIONS_PER_ACCOUNT=5
REALTIME_MAX_PAYLOAD_BYTES=16384
REALTIME_COMMAND_RATE_LIMIT=60
REALTIME_COMMAND_RATE_WINDOW_SECONDS=60
REALTIME_SHUTDOWN_TIMEOUT_MS=10000
REALTIME_MESSAGE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
REALTIME_MESSAGE_ENCRYPTION_KEY_VERSION=local-v1
REALTIME_MESSAGE_DECRYPTION_KEYS={}

# MB-689: independent BFF and Realtime RS256 keys; no Identity private key reuse.
