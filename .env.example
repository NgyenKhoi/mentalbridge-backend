# Shared service discovery URL. Required outside local development.
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_CLIENT_ENABLED=false

# Identity service-owned PostgreSQL database. Create it before running Liquibase or the service.
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/mentalbridge_identity
IDENTITY_DB_USERNAME=mentalbridge_identity
IDENTITY_DB_PASSWORD=replace-with-a-local-secret
IDENTITY_JWT_ISSUER=https://identity.local.mentalbridge
IDENTITY_JWT_AUDIENCE=mentalbridge-api
IDENTITY_JWT_KEY_ID=local-development-key
IDENTITY_JWT_PRIVATE_KEY=replace-with-pkcs8-pem-private-key
IDENTITY_JWT_PUBLIC_KEY=replace-with-x509-pem-public-key
IDENTITY_ENCRYPTION_KEY_VERSION=local-v1
IDENTITY_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
IDENTITY_BREVO_BASE_URL=https://api.brevo.com
IDENTITY_BREVO_API_KEY=replace-with-a-development-brevo-key
IDENTITY_BREVO_SENDER_EMAIL=replace-with-a-verified-development-sender
IDENTITY_BREVO_SENDER_NAME=MentalBridge
IDENTITY_VERIFICATION_URL=http://localhost:3000/verify-email
IDENTITY_PASSWORD_RECOVERY_URL=http://localhost:3000/reset-password

# Care service-owned PostgreSQL database. Create it before running Liquibase or the service.
CARE_DB_URL=jdbc:postgresql://localhost:5432/mentalbridge_care
CARE_DB_USERNAME=mentalbridge_care
CARE_DB_PASSWORD=replace-with-a-local-secret
CARE_ANONYMOUS_SESSION_TTL=PT30M
CARE_ANONYMOUS_SESSION_MAXIMUM_LIFETIME=PT2H
CARE_PHQ9_SAFETY_POLICY_VERSION=replace-with-approved-policy-version
CARE_IDEMPOTENCY_HMAC_KEY=replace-with-at-least-32-random-characters

# Journal and AI service-owned MongoDB database and Identity JWT verification.
JOURNAL_AI_PORT=3000
JOURNAL_AI_LOG_LEVEL=info
JOURNAL_AI_MONGODB_URI=mongodb://localhost:27017
JOURNAL_AI_MONGODB_DATABASE=mentalbridge_journal_ai
JOURNAL_AI_MONGODB_CONNECTION_TIMEOUT_MS=2000

# Realtime service-owned MongoDB, ephemeral Redis, socket limits and message encryption.
REALTIME_PORT=3004
REALTIME_LOG_LEVEL=info
REALTIME_CORS_ORIGINS=http://localhost:3000
REALTIME_MONGODB_URI=mongodb://localhost:27017
REALTIME_MONGODB_DATABASE=mentalbridge_realtime
REALTIME_MONGODB_CONNECTION_TIMEOUT_MS=2000
REALTIME_REDIS_URL=redis://localhost:6379
REALTIME_REDIS_CONNECTION_TIMEOUT_MS=1000
REALTIME_PRESENCE_TTL_SECONDS=45
REALTIME_PRESENCE_HEARTBEAT_SECONDS=15
REALTIME_MAX_CONNECTIONS_PER_ACCOUNT=5
REALTIME_MAX_PAYLOAD_BYTES=16384
REALTIME_COMMAND_RATE_LIMIT=60
REALTIME_COMMAND_RATE_WINDOW_SECONDS=60
REALTIME_SHUTDOWN_TIMEOUT_MS=10000
REALTIME_MESSAGE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
REALTIME_MESSAGE_ENCRYPTION_KEY_VERSION=local-v1
REALTIME_MESSAGE_DECRYPTION_KEYS={}
IDENTITY_JWT_CLOCK_TOLERANCE_SECONDS=60
