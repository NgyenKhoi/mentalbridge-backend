# Consultation service-owned PostgreSQL database. Create it before running Liquibase or the service.
CONSULTATION_DB_URL=jdbc:postgresql://localhost:5432/mentalbridge_consultation
CONSULTATION_DB_USERNAME=mentalbridge_consultation
CONSULTATION_DB_PASSWORD=replace-with-a-local-secret
CONSULTATION_CREDENTIAL_STORAGE_ENABLED=false
CONSULTATION_CLOUDINARY_CLOUD_NAME=
CONSULTATION_CLOUDINARY_API_KEY=
CONSULTATION_CLOUDINARY_API_SECRET=
CONSULTATION_CLOUDINARY_TIMEOUT_SECONDS=5
CONSULTATION_LIQUIBASE_ENABLED=true
CONSULTATION_VIDEO_AVAILABILITY_ENABLED=false
CONSULTATION_VIDEO_ENABLED=false
# Opt-in local/dev DEMO video only. Keep false for ordinary scheduling and staging/production.
CONSULTATION_DEMO_IMMEDIATE_VIDEO_ENABLED=false
