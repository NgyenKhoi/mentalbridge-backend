# Shared service discovery URL. Required outside local development.
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_CLIENT_ENABLED=false

# Identity service-owned PostgreSQL database. Create it before running Liquibase or the service.
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/mentalbridge_identity
IDENTITY_DB_USERNAME=mentalbridge_identity
IDENTITY_DB_PASSWORD=replace-with-a-local-secret
IDENTITY_JWT_ISSUER=https://identity.local.mentalbridge
IDENTITY_JWT_AUDIENCE=mentalbridge-api
IDENTITY_JWT_KEY_ID=local-development-key
IDENTITY_JWT_PRIVATE_KEY=replace-with-pkcs8-pem-private-key
IDENTITY_JWT_PUBLIC_KEY=replace-with-x509-pem-public-key
IDENTITY_ENCRYPTION_KEY_VERSION=local-v1
IDENTITY_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
IDENTITY_BREVO_BASE_URL=https://api.brevo.com
IDENTITY_BREVO_API_KEY=replace-with-a-development-brevo-key
IDENTITY_BREVO_SENDER_EMAIL=replace-with-a-verified-development-sender
IDENTITY_BREVO_SENDER_NAME=MentalBridge
IDENTITY_NOTIFICATION_SERVICE_TOKEN=replace-with-shared-32-character-secret
IDENTITY_VERIFICATION_URL=http://localhost:3000/verify-email
IDENTITY_PASSWORD_RECOVERY_URL=http://localhost:3000/reset-password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
IDENTITY_OUTBOX_RELAY_ENABLED=false
IDENTITY_OUTBOX_RELAY_BATCH_SIZE=100
IDENTITY_OUTBOX_RELAY_INTERVAL=PT5S
IDENTITY_OUTBOX_RELAY_SEND_TIMEOUT=PT5S
IDENTITY_OUTBOX_RELAY_RETRY_BASE=PT5S
IDENTITY_OUTBOX_RELAY_RETRY_MAXIMUM=PT5M

# Care service-owned PostgreSQL database. Create it before running Liquibase or the service.
