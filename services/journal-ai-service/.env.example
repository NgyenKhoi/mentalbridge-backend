# HTTP port used by the Journal and AI Service.
PORT=3000

# development, test, or production.
NODE_ENV=development

# Pino log level.
LOG_LEVEL=info

# Service label used in logs and metrics.
SERVICE_NAME=journal-ai-service

# MongoDB database owned by the Journal and AI Service.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mentalbridge_journal_ai
