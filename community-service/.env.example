# Community-owned PostgreSQL database (required)
COMMUNITY_DB_URL=jdbc:postgresql://localhost:5432/mentalbridge_community
COMMUNITY_DB_USERNAME=replace-community-db-user
COMMUNITY_DB_PASSWORD=replace-community-db-password
COMMUNITY_LIQUIBASE_ENABLED=false

# Identity-issued JWT verification (required; use an escaped PEM or base64 DER public key)
IDENTITY_JWT_ISSUER=https://identity.example.com
IDENTITY_JWT_AUDIENCE=mentalbridge-api
IDENTITY_JWT_PUBLIC_KEY=replace-identity-rsa-public-key

# Cloudinary credentials (required; never commit real values)
CLOUDINARY_CLOUD_NAME=replace-cloud-name
CLOUDINARY_API_KEY=replace-api-key
CLOUDINARY_API_SECRET=replace-api-secret
CLOUDINARY_TIMEOUT_SECONDS=5

# Bounded media lifecycle (optional safe defaults)
COMMUNITY_MEDIA_MAX_IMAGE_BYTES=10485760
COMMUNITY_MEDIA_MAX_VIDEO_BYTES=52428800
COMMUNITY_MEDIA_MAX_VIDEO_DURATION_SECONDS=60
COMMUNITY_MEDIA_UPLOAD_INTENT_TTL=10m
COMMUNITY_MEDIA_ORPHAN_RETENTION=24h
COMMUNITY_MEDIA_CLEANUP_INTERVAL=1h

# Community interaction outbox relay (enable only after the versioned topic is provisioned)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
COMMUNITY_INTERACTION_RELAY_ENABLED=false
COMMUNITY_INTERACTION_RELAY_BATCH_SIZE=100
COMMUNITY_INTERACTION_RELAY_INTERVAL=PT5S
COMMUNITY_INTERACTION_RELAY_SEND_TIMEOUT=PT5S
COMMUNITY_INTERACTION_RELAY_RETRY_BASE=PT5S
COMMUNITY_INTERACTION_RELAY_RETRY_MAXIMUM=PT5M

# Runtime/discovery
SERVER_PORT=8084
EUREKA_CLIENT_ENABLED=false
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
