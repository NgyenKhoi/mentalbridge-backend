# Copy this file to .env before starting the Review 1 Compose stack.
# Replace every replace-* value. Never commit the resulting .env file.

# Shared pre-production data plane. Dev and staging use these same service-owned
# cloud databases. Production will receive separate endpoints and credentials.
IDENTITY_DB_URL=jdbc:postgresql://shared-preprod-rds.example:5432/mentalbridge_identity?sslmode=require
IDENTITY_DB_USERNAME=replace-with-identity-database-user
IDENTITY_DB_PASSWORD=replace-with-a-random-identity-password
CARE_DB_URL=jdbc:postgresql://shared-preprod-rds.example:5432/mentalbridge_care?sslmode=require
CARE_DB_USERNAME=replace-with-care-database-user
CARE_DB_PASSWORD=replace-with-a-random-care-password
CONSULTATION_DB_URL=jdbc:postgresql://shared-preprod-rds.example:5432/mentalbridge_consultation?sslmode=require
CONSULTATION_DB_USERNAME=replace-with-consultation-database-user
CONSULTATION_DB_PASSWORD=replace-with-a-random-consultation-password
CONSULTATION_VIDEO_AVAILABILITY_ENABLED=false
CONSULTATION_VIDEO_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=PT2M
CONSULTATION_PAYOUT_MODE=FAKE
CONSULTATION_PAYOUT_SETTLEMENT_HOLD=P7D
CONSULTATION_PAYOUT_MINIMUM_WITHDRAWAL_VND=100000
CONSULTATION_PAYOUT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CONSULTATION_PAYOUT_ENCRYPTION_KEY_VERSION=v1
MOMO_PAYOUT_PARTNER_CODE=
MOMO_PAYOUT_ACCESS_KEY=
MOMO_PAYOUT_SECRET_KEY=
MOMO_PAYOUT_PRODUCTION_APPROVED=false
MOMO_PAYOUT_BASE_URL=https://test-payment.momo.vn
MOMO_PAYOUT_STORE_ID=
MOMO_PAYOUT_PUBLIC_KEY=
MOMO_PAYOUT_IPN_URL=
COMMUNITY_DB_URL=jdbc:postgresql://shared-preprod-rds.example:5432/mentalbridge_community?sslmode=require
COMMUNITY_DB_USERNAME=replace-with-community-database-user
COMMUNITY_DB_PASSWORD=replace-with-a-random-community-password
CONTENT_DATABASE_URL=postgres://replace-with-content-database-user:replace-with-url-encoded-content-password@shared-preprod-rds.example:5432/mentalbridge_content_notification?sslmode=require
CONTENT_NODE_OPTIONS=

IDENTITY_JWT_ISSUER=https://identity.local.mentalbridge
IDENTITY_JWT_AUDIENCE=mentalbridge-api
IDENTITY_JWT_KEY_ID=review1-demo-key
IDENTITY_JWT_PRIVATE_KEY=replace-with-pkcs8-pem-private-key
IDENTITY_JWT_PUBLIC_KEY=replace-with-x509-pem-public-key
IDENTITY_ENCRYPTION_KEY_VERSION=review1-demo-v1
IDENTITY_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
IDENTITY_VERIFICATION_DELIVERY_MODE=local-file
IDENTITY_SPRING_PROFILES_ACTIVE=dev
IDENTITY_VERIFICATION_URL=http://localhost:3000/verify-email
IDENTITY_OUTBOX_RELAY_ENABLED=true
IDENTITY_OUTBOX_RELAY_BATCH_SIZE=100
IDENTITY_OUTBOX_RELAY_INTERVAL=PT5S
IDENTITY_OUTBOX_RELAY_SEND_TIMEOUT=PT5S
IDENTITY_OUTBOX_RELAY_RETRY_BASE=PT5S
IDENTITY_OUTBOX_RELAY_RETRY_MAXIMUM=PT5M

CARE_IDEMPOTENCY_HMAC_KEY=replace-with-at-least-32-random-characters
CARE_PHQ9_SAFETY_POLICY_VERSION=MB-SAFETY-PHQ9-001/1.0-capstone

CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CONSULTATION_CREDENTIAL_STORAGE_ENABLED=false
CONSULTATION_CLOUDINARY_CLOUD_NAME=
CONSULTATION_CLOUDINARY_API_KEY=
CONSULTATION_CLOUDINARY_API_SECRET=
CONSULTATION_CLOUDINARY_TIMEOUT_SECONDS=5

JOURNAL_AI_REMINDER_SERVICE_TOKEN=replace-with-shared-32-character-secret
IDENTITY_NOTIFICATION_SERVICE_TOKEN=replace-with-shared-32-character-secret
JOURNAL_AI_IDEMPOTENCY_HMAC_KEY=replace-with-a-different-base64-encoded-32-byte-key
CONTENT_REMINDER_SCHEDULER_ENABLED=true
CONTENT_REMINDER_SCHEDULER_INTERVAL_MS=60000
CONTENT_REMINDER_SCHEDULER_BATCH_SIZE=100
CONTENT_WELLBEING_DIGEST_SCHEDULER_ENABLED=true
CONTENT_WELLBEING_DIGEST_SCHEDULER_INTERVAL_MS=60000
CONTENT_WELLBEING_DIGEST_BATCH_SIZE=100
CONTENT_ACCOUNT_LIFECYCLE_CONSUMER_ENABLED=true
CONTENT_COMMUNITY_INTERACTION_CONSUMER_ENABLED=true

PUBLIC_APP_ORIGIN=http://localhost:3000
PUBLIC_REALTIME_ORIGIN=http://localhost:3004
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
SERVICE_BIND_ADDRESS=127.0.0.1

# full-test profile only. MongoDB is the shared dev/staging cloud deployment;
# Redis remains a local ephemeral dependency. URL passwords must be URL-encoded.
REALTIME_MONGODB_URI=mongodb+srv://replace-with-mongo-user:replace-with-url-encoded-mongo-password@shared-preprod-mongodb.example/mentalbridge_realtime
REALTIME_MONGODB_DATABASE=mentalbridge_realtime
REDIS_PASSWORD=replace-with-a-random-redis-password
CARE_REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379
REALTIME_REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379
CARE_SUPPORT_PLAN_COMPANION_SERVICE_TOKEN=replace-with-a-shared-care-journal-companion-token-of-at-least-32-characters
CONSULTATION_BASE_URL=http://consultation:8082
CONSULTATION_TIMEOUT_MS=2000
CONSULTATION_EVIDENCE_SERVICE_TOKEN=replace-with-shared-at-least-32-character-token
REALTIME_MESSAGE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
REALTIME_MESSAGE_ENCRYPTION_KEY_VERSION=review1-demo-v1
REALTIME_MESSAGE_DECRYPTION_KEYS={}

# MB-689: enable only after BFF integration and independent signing keys are provisioned.
REALTIME_COMMUNITY_ENABLED=false
REALTIME_COMMUNITY_BASE_URL=http://community:8084
REALTIME_COMMUNITY_DELEGATION_PRIVATE_KEY=
REALTIME_COMMUNITY_DELEGATION_PUBLIC_KEY=
REALTIME_COMMUNITY_DELEGATION_KEY_ID=
REALTIME_COMMUNITY_BFF_PUBLIC_KEY=
REALTIME_COMMUNITY_BFF_KEY_ID=
REALTIME_COMMUNITY_KAFKA_GROUP=realtime-community-v1
REALTIME_COMMUNITY_REDIS_CHANNEL=mentalbridge:community:preprod:v1:fanout
COMMUNITY_CHAT_REALTIME_ENABLED=false
JOURNAL_AI_ENCRYPTION_KEY=replace-with-a-separate-base64-encoded-32-byte-key
# Comma-separated Identity ADMIN UUIDs authorized to approve exact resource versions.
# Empty keeps the publication review gate fail-closed.
CONTENT_RESOURCE_REVIEWER_ACCOUNT_IDS=

# MB-685 is opt-in. Supply dedicated credentials and a real AES key before enabling.
COMMUNITY_CHAT_ENABLED=false
IDENTITY_COMMUNITY_CHAT_SERVICE_TOKEN=
COMMUNITY_CHAT_IDENTITY_BASE_URL=http://identity:8080
COMMUNITY_CHAT_IDENTITY_CONNECT_TIMEOUT=PT0.5S
COMMUNITY_CHAT_IDENTITY_READ_TIMEOUT=PT1.5S
COMMUNITY_CHAT_ENCRYPTION_KEY=
COMMUNITY_CHAT_ENCRYPTION_KEY_VERSION=v1
COMMUNITY_CHAT_DECRYPTION_KEYS={}
COMMUNITY_CHAT_RELAY_ENABLED=false
COMMUNITY_CHAT_RELAY_BATCH_SIZE=100
COMMUNITY_CHAT_RELAY_INTERVAL=PT5S

COMMUNITY_CHAT_GROUP_MEMBER_LIMIT=30

COMMUNITY_CHAT_NOTIFICATION_ENABLED=false
CONTENT_COMMUNITY_NOTICE_CONSUMER_ENABLED=false
CONTENT_COMMUNITY_NOTIFICATION_PUBLIC_KEY=
CONTENT_COMMUNITY_NOTIFICATION_PRIVATE_KEY=
CONTENT_COMMUNITY_NOTIFICATION_KEY_ID=
