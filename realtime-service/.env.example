NODE_ENV=development
REALTIME_PORT=3004
REALTIME_LOG_LEVEL=info
REALTIME_CORS_ORIGINS=http://localhost:3000
REALTIME_MONGODB_URI=mongodb://localhost:27017
REALTIME_MONGODB_DATABASE=mentalbridge_realtime
REALTIME_MONGODB_CONNECTION_TIMEOUT_MS=2000
REALTIME_REDIS_URL=redis://localhost:6379
CONSULTATION_BASE_URL=http://localhost:8082
CONSULTATION_TIMEOUT_MS=2000
CONSULTATION_EVIDENCE_SERVICE_TOKEN=replace-with-shared-at-least-32-character-token
REALTIME_REDIS_CONNECTION_TIMEOUT_MS=1000
REALTIME_PRESENCE_TTL_SECONDS=45
REALTIME_PRESENCE_HEARTBEAT_SECONDS=15
REALTIME_MAX_CONNECTIONS_PER_ACCOUNT=5
REALTIME_MAX_PAYLOAD_BYTES=16384
REALTIME_COMMAND_RATE_LIMIT=60
REALTIME_COMMAND_RATE_WINDOW_SECONDS=60
REALTIME_SHUTDOWN_TIMEOUT_MS=10000
REALTIME_MESSAGE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
REALTIME_MESSAGE_ENCRYPTION_KEY_VERSION=local-v1
REALTIME_MESSAGE_DECRYPTION_KEYS={}
REALTIME_COMMUNITY_ENABLED=false
REALTIME_COMMUNITY_BASE_URL=http://localhost:8084
REALTIME_COMMUNITY_DELEGATION_PRIVATE_KEY=
REALTIME_COMMUNITY_DELEGATION_KEY_ID=
REALTIME_COMMUNITY_BFF_PUBLIC_KEY=
REALTIME_COMMUNITY_BFF_KEY_ID=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REALTIME_COMMUNITY_KAFKA_GROUP=realtime-community-v1
REALTIME_COMMUNITY_REDIS_CHANNEL=mentalbridge:community:local:v1:fanout
IDENTITY_JWT_ISSUER=https://identity.local.mentalbridge
IDENTITY_JWT_AUDIENCE=mentalbridge-api
IDENTITY_JWT_KEY_ID=local-development-key
IDENTITY_JWT_PUBLIC_KEY=replace-with-x509-pem-public-key
IDENTITY_JWT_CLOCK_TOLERANCE_SECONDS=60
