# Consultation-owned PostgreSQL connection used by the runtime and Liquibase job.
CONSULTATION_DB_URL=jdbc:postgresql://localhost:5432/mentalbridge_consultation
CONSULTATION_DB_USERNAME=mentalbridge_consultation
CONSULTATION_DB_PASSWORD=replace-with-a-local-secret
CONSULTATION_LIQUIBASE_ENABLED=false

# Keep video publication disabled until its provider contract gate passes.
CONSULTATION_VIDEO_AVAILABILITY_ENABLED=false

# Appointment status outbox for the one-reminder flow. Use the same secret in
# Consultation, Identity, and Content/Notification; never commit a real value.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APPOINTMENT_REMINDER_SERVICE_TOKEN=replace-with-shared-32-character-secret
CONSULTATION_APPOINTMENT_OUTBOX_RELAY_ENABLED=false
CONSULTATION_APPOINTMENT_OUTBOX_BATCH_SIZE=100
CONSULTATION_APPOINTMENT_OUTBOX_INTERVAL=PT5S
CONSULTATION_APPOINTMENT_OUTBOX_SEND_TIMEOUT=PT5S
CONSULTATION_APPOINTMENT_OUTBOX_RETRY_BASE=PT5S
CONSULTATION_APPOINTMENT_OUTBOX_RETRY_MAXIMUM=PT5M
